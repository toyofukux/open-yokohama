---
import Layout from "../../layouts/Layout.astro";
import {
  records,
  statusLabels,
} from "../../../../../packages/core/corrections";
---

<Layout
  title="問い合わせと訂正"
  description="誤り・質問・要望の送り方と、対応した内容の記録。"
>
  <article class="container narrow section prose">
    <p class="breadcrumb"><a href="/">ホーム</a> / 問い合わせと訂正</p>
    <h1 class="page-title">問い合わせと訂正</h1>
    <p class="lede">
      数字や説明の誤り、質問、要望を、アカウントなしで送れます。
    </p>
    <p><a href="/corrections/report/">誤りや意見を送る →</a></p>
    <h2>送る前に</h2>
    <ul>
      <li>個別の返信はしません。対応した内容はこのページに記録します。</li>
      <li>
        送った内容は運営だけが読みます。氏名・連絡先などの個人情報は書かないでください。
      </li>
      <li>
        正しい答えが分からなくても構いません。出典は分かる範囲で結構です。
      </li>
    </ul>
    <h2>送ってから訂正まで</h2>
    <ol>
      <li>送信すると受付番号が表示されます。</li>
      <li>運営が原典と照合し、確認状況をこのページに記録します。</li>
      <li>
        訂正または対応終了の理由を記録し、サイトの履歴へ反映します。重大な疑義がある説明は、確認中として表示を保留する場合があります。
      </li>
    </ol>
    <h2>対応した記録</h2>
    {
      records.length === 0 ? (
        <p>
          まだ記録はありません。誤りや未対応の報告がないことを意味しません。
        </p>
      ) : (
        records.map((record) => (
          <section id={record.id} class="note">
            <>
              <h3>
                {statusLabels[record.status]}
                {record.hold && "・表示保留"}
              </h3>
              <>
                <p>{record.reason}</p>
                <p>
                  受付番号：{record.inquiryId} · 更新：
                  {record.updatedAt.slice(0, 10)}
                </p>
              </>
              <p>
                <a href={record.page}>対象ページ</a>
              </p>
              {record.resolution && <p>{record.resolution}</p>}
              {record.status === "corrected" && (
                <p>
                  <a
                    href={`https://github.com/toyofukux/open-yokohama/commit/${record.revision}`}
                  >
                    訂正差分
                  </a>
                </p>
              )}
            </>
          </section>
        ))
      )
    }
  </article>
</Layout>
