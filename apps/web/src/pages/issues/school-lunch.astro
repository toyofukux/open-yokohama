---
import Layout from "../../layouts/Layout.astro";
import {
  Content,
  getHeadings,
} from "../../../../../docs/content-review/school-lunch/DRAFT.md";
import evidence from "../../../../../docs/content-review/school-lunch/evidence.json";
import { schoolLunch } from "../../../../../packages/core/policy-issues";
import { reportUrl } from "../../../../../packages/core/corrections";
import "../../styles/policy-article.css";
const headings = getHeadings().filter(
  (heading) => heading.depth === 2 && heading.slug !== "footnote-label",
);
---

<Layout
  title={schoolLunch.title}
  description={schoolLunch.summary}
  dataVersion={`記事 SHA-256:${evidence.manuscript.sha256}`}
>
  <article
    class="policy-article container"
    data-content-version={evidence.manuscript.sha256}
  >
    <header class="policy-header" id="article-top">
      <p class="breadcrumb">
        <a href="/">ホーム</a> / <a href="/issues/">暮らしの問い</a> / 給食費
      </p>
      <div class="policy-kicker">
        <span>政策を考える</span><span>{schoolLunch.category}</span>
      </div>
      <h1>
        横浜は、中学校の給食費も<br class="desktop-break" />無償化すべきか
      </h1>
      <div class="policy-meta">
        <span>2026年度の制度</span><span>原稿更新：2026年9月9日</span><a
          href="#review-status">確認の範囲</a
        >
      </div>
    </header>

    <div class="policy-layout">
      <aside class="policy-sidebar">
        <details class="policy-toc">
          <summary>この問いをたどる（目次）</summary>
          <nav aria-label="この記事の目次">
            <ol>
              {
                headings.map((heading, i) => (
                  <li>
                    <a href={`#${heading.slug}`}>
                      <span aria-hidden="true">
                        {String(i + 1).padStart(2, "0")}
                      </span>
                      {heading.text}
                    </a>
                  </li>
                ))
              }
            </ol>
            <a class="source-jump" href="#article-sources">原資料を確かめる ↗</a
            >
          </nav>
        </details>
      </aside>
      <div class="policy-body">
        <div class="policy-prose"><Content /></div>

        <section class="policy-sources" aria-labelledby="article-sources">
          <h2 id="article-sources">原資料を確かめる</h2>
          <p class="small muted">
            本文の脚注に、説明に対応する原資料と確認箇所を記載している。
          </p>
          <details id="review-status">
            <summary>この原稿の確認範囲と、残っていること</summary>
            <p>
              公式資料との照合・数値検算は制作側が実施した。採用原稿・主要な根拠・実装は別の担当も照合した。全文章の独立した事実確認と利用者による理解の検証は未実施。無償化の正味追加費用と、複数年度の継続財源は確定していない。
            </p>
            <p>
              制度説明は2026年度、政策資料は本文に記載した時点のもの。すべての補正予算・議事録を網羅した確認ではない。
            </p>
          </details>
          <div class="article-bottom">
            <a
              href={reportUrl(
                Astro.url.pathname,
                `記事 SHA-256:${evidence.manuscript.sha256}`,
              )}>数字や説明について知らせる</a
            ><a href="#article-top">冒頭に戻る ↑</a>
          </div>
        </section>
      </div>
    </div>
  </article>
</Layout>

<script>
  const toc = document.querySelector<HTMLDetailsElement>(".policy-toc");
  const wide = matchMedia("(min-width: 901px)");
  const setInitialContents = () => {
    if (toc) toc.open = wide.matches;
  };
  setInitialContents();
  wide.addEventListener("change", setInitialContents);
</script>
