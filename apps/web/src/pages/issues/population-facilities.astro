---
import PolicyArticle from "../../components/PolicyArticle.astro";
import {
  Content,
  getHeadings,
  frontmatter,
} from "../../../../../docs/content-review/expansion/population-facilities.md";
import inventory from "../../../../../docs/content-review/expansion/sources.json";
import { createHash } from "node:crypto";
import { readFileSync } from "node:fs";
const version = createHash("sha256")
  .update(
    readFileSync(
      new URL(
        "../../../../../docs/content-review/expansion/population-facilities.md",
        import.meta.url,
      ),
    ),
  )
  .digest("hex");
const sources = inventory.filter((s) => frontmatter.sourceIds.includes(s.id));
---

<PolicyArticle
  title={frontmatter.title}
  summary={frontmatter.summary}
  category={frontmatter.category}
  headings={getHeadings()}
  version={version}
  revisedOn="2026年9月9日"
  reviewedIndependently={true}
  sources={sources}><Content /></PolicyArticle
>
