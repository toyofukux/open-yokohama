---
import { createHash } from "node:crypto";
import raw from "../../../../data/published/ages.json?raw";
import { stacks, lines } from "../chart-html";
import { ageStories } from "../region-stories";
import { storyHtml } from "../region-story-html";
import RegionStoryStyle from "../components/RegionStoryStyle.astro";
import RegionalQuestions from "../components/RegionalQuestions.astro";
import ChartStyle from "../components/ChartStyle.astro";
import Layout from "../layouts/Layout.astro";
import SourceLink from "../components/SourceLink.astro";
import { ages } from "../ages-data";
import { ageMetrics } from "../../../../packages/core/ages";
import { geographies, number } from "../data";
const periods = [...new Set(ages.records.map((r) => r.period))]
  .sort()
  .reverse();
const period = periods[0];
const source = ages.snapshots[0];
const columns = ageMetrics.filter((m) => m.id !== "age_total");
const rows = ages.records.filter((r) => r.period === period);
const history = ages.records
  .filter((r) => r.geography === "141003")
  .sort((a, b) => b.period.localeCompare(a.period));
const display = (count: number, total: number) =>
  `${number(count)}（${((count / total) * 100).toFixed(1)}%）`;
const version = createHash("sha256").update(raw).digest("hex");
const compact = ages.records.map((r) => ({
  geography: r.geography,
  period: r.period,
  values: r.values,
}));
---

<Layout
  title="子ども・高齢者と年齢構成を比べる"
  dataVersion={`年齢別人口 SHA-256:${version}`}
>
  <article class="container section prose">
    <p class="breadcrumb"><a href="/">ホーム</a> / 年齢構成</p>
    <h1 class="page-title">年齢構成から、地域の変化と暮らしを考える。</h1>
    <p class="lede">
      2000〜{
        period.slice(0, 4)
      }年の各年1月1日現在の推計人口です。年齢を3区分に集計し、年齢不詳を別に表示します。<SourceLink
        href={source.sourcePage}
      />
    </p>
    <p class="note">
      割合の分母は、年齢不詳を含む総人口です。不詳を除いた割合とは異なり、四捨五入により合計が100%にならない場合があります。
    </p>
    <h2>地域を選んで、世代の変化を読む</h2>
    <label
      >推移を見る地域<select id="age-geography" disabled
        >{
          geographies.map((g) => <option value={g.code}>{g.name}</option>)
        }</select
      ></label
    >
    <RegionStoryStyle />
    <div id="age-story" set:html={storyHtml(ageStories["141003"], "ages")} />
    <h3>人口全体と各世代の、変化の大きさを比べる</h3>
    <p>
      最初の年の人数をそれぞれ100とします。200なら2倍、80なら2割減です。世代同士の人数の大小ではなく、増減の大きさを比べます。
    </p>
    <div
      id="age-index-chart"
      set:html={lines(
        [...history].reverse().map((r) => r.period.slice(0, 4)),
        (
          [
            ["age_total", "総人口"],
            ["age_under15", "0〜14歳"],
            ["age_65plus", "65歳以上"],
          ] as const
        ).map(([key, name]) => ({
          name,
          values: [...history]
            .reverse()
            .map(
              (r) =>
                (r.values[key] / history[history.length - 1].values[key]) * 100,
            ),
        })),
        "横浜市の人数の変化（最初の年＝100）",
        `${history[history.length - 1].period.slice(0, 4)}年＝100`,
        false,
        100,
      )}
    />
    <h3>世代の割合の変化も確かめる</h3>
    <div
      id="age-history-chart"
      set:html={lines(
        [...history].reverse().map((r) => r.period.slice(0, 4)),
        columns.map((m) => ({
          name: m.name.replace("の人口", ""),
          values: [...history]
            .reverse()
            .map((r) => (r.values[m.id] / r.values.age_total) * 100),
        })),
        "横浜市の年齢構成の推移（各年1月1日）",
        "%",
      )}
    />
    <details class="numeric-supplement">
      <summary>年ごとの人数・割合を表で確認する</summary>
      <div
        class="table-wrap"
        tabindex="0"
        role="region"
        aria-label="年齢構成の年別推移。横にスクロールできます"
      >
        <table>
          <caption id="age-history-caption"
            >横浜市の各年1月1日現在の人数（人）と総人口に対する割合（%）。</caption
          >
          <thead
            ><tr
              ><th scope="col">時点</th><th scope="col" class="numeric"
                >総人口（人）</th
              >{
                columns.map((m) => (
                  <th scope="col" class="numeric">
                    {m.name}
                  </th>
                ))
              }</tr
            ></thead
          >
          <tbody id="age-history"
            >{
              history.map((r) => (
                <tr>
                  <>
                    <th scope="row">{r.period}</th>
                    <td class="numeric">{number(r.values.age_total)}</td>
                    {columns.map((m) => (
                      <td class="numeric">
                        {display(r.values[m.id], r.values.age_total)}
                      </td>
                    ))}
                  </>
                </tr>
              ))
            }</tbody
          >
        </table>
      </div>
    </details>
    <h2>同じ時点で市と18区を比較する</h2>
    <label
      >年齢別人口の時点<select id="age-period" disabled
        >{periods.map((p) => <option value={p}>{p}</option>)}</select
      ></label
    >
    <p id="age-status" role="status" aria-live="polite">
      {period}現在の人数と割合を表示しています。
    </p>
    <ChartStyle />
    <div
      id="age-chart"
      set:html={stacks(
        rows.map((r) => ({
          label: geographies.find((g) => g.code === r.geography)!.name,
          values: columns.map((m) => r.values[m.id]),
          total: r.values.age_total,
        })),
        `${period}現在の年齢構成（%）`,
      )}
    />
    <details class="numeric-supplement">
      <summary>市と18区の人数・割合を表で確認する</summary>
      <div
        class="table-wrap"
        tabindex="0"
        role="region"
        aria-label="市と18区の年齢構成。横にスクロールできます"
      >
        <table>
          <caption id="age-caption"
            >{
              period
            }現在の人数（人）と総人口に対する割合（%）。市・区の掲載順。</caption
          >
          <thead
            ><tr
              ><th scope="col">地域</th><th scope="col" class="numeric"
                >総人口（人）</th
              >{
                columns.map((m) => (
                  <th scope="col" class="numeric">
                    {m.name}
                  </th>
                ))
              }</tr
            ></thead
          >
          <tbody id="age-body"
            >{
              rows.map((r) => (
                <tr>
                  <>
                    <th scope="row">
                      <a
                        href={
                          r.geography === "141003"
                            ? "/"
                            : `/wards/${geographies.find((g) => g.code === r.geography)!.slug}/`
                        }
                      >
                        {geographies.find((g) => g.code === r.geography)!.name}
                      </a>
                    </th>
                    <td class="numeric">{number(r.values.age_total)}</td>
                    {columns.map((m) => (
                      <td class="numeric">
                        {display(r.values[m.id], r.values.age_total)}
                      </td>
                    ))}
                  </>
                </tr>
              ))
            }</tbody
          >
        </table>
      </div>
    </details>
    <noscript
      ><p class="note">
        最新の年の市区比較と、市全体の年別推移を表示しています。選択の切り替えにはJavaScriptが必要です。すべての地域・年の数値はCSV/JSONでも取得できます。
      </p></noscript
    >
    <RegionalQuestions />
    <h2>定義と読み方</h2>
    {
      ageMetrics.map((m) => (
        <details>
          <>
            <summary>{m.name}</summary>
            <p>{m.definition}</p>
          </>
        </details>
      ))
    }
    <p>
      人数の差と割合の差は別の情報です。15〜64歳の人口は働いている人の人数ではありません。年齢構成だけで、子育て施策や高齢者支援の効果を判断することはできません。
    </p>
    <p>
      国勢調査に基づく推計の見直しや年齢不詳の人数の違いが、比較に影響する場合があります。住民基本台帳による3月末・9月末の年齢別人口とは混ぜていません。<a
        href="https://www.city.yokohama.lg.jp/city-info/yokohamashi/tokei-chosa/portal/jinko/nenrei/"
        >横浜市の年齢別人口の説明</a
      >
    </p>
    <h2>出典と確認範囲</h2>
    <p>
      横浜市統計書 第2章
      表5を加工しています。各歳・男女計・年齢不詳・市区合計を検査し、3区分の集計に使った原典行をCSV/JSONへ保存しています。専門家監修や市民の理解テストの完了を示すものではありません。
    </p>
    <p>
      横浜市提供・CC BY 4.0。原本取得日：{
        source.retrievedAt.slice(0, 10)
      }。公表日：不明。
    </p>
    <div class="pill-list">
      <a href={source.sourcePage}>横浜市の掲載ページ</a><a href={source.url}
        >CSVダウンロード（横浜市）</a
      ><a href={`/data/raw/${source.id}.csv`} download>取得時点の原本CSV</a><a
        href="/data/ages.csv"
        download>加工済みCSV</a
      ><a href="/data/ages.json" download>出典付きJSON</a><a
        href="/population-movement/">出生・死亡・転出入の内訳</a
      >
    </div>
    <details><summary>原本の識別情報</summary><code>{source.id}</code></details>
  </article>
  <script
    is:inline
    id="age-data"
    type="application/json"
    set:html={JSON.stringify({
      records: compact,
      stories: ageStories,
      geographies,
      columns: columns.map((m) => m.id),
    }).replaceAll("<", "\\u003c")}
  />
  <script>
    import "../scripts/age-structure";
  </script>
</Layout>
