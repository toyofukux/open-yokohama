---
import "../styles/global.css";
import { releaseId } from "../../../../packages/warehouse/current";
import { geographies } from "../../../../packages/core/schema";
import { createHash } from "node:crypto";
import populationJson from "../../../../data/published/population.json?raw";
import { heldPage, reportUrl } from "../../../../packages/core/corrections";
const populationVersion = createHash("sha256")
  .update(populationJson)
  .digest("hex");

import "../styles/themes.css";
import {
  resolveTheme,
  yokohamaSunTimes,
  themeConfig,
  themeColors,
  themeIds,
} from "../../../../packages/core/theme";
const themeScript = `(() => {
  const yokohamaSunTimes = ${yokohamaSunTimes.toString()};
  const select = ${resolveTheme.toString()};
  const config = ${JSON.stringify(themeConfig)};
  const colors = ${JSON.stringify(themeColors)};
  const ids = ${JSON.stringify(themeIds)};
  const preview = new URLSearchParams(location.search).get('theme');
  const apply = () => {
    const theme = ids.includes(preview) ? preview : select(config, Date.now());
    document.documentElement.dataset.theme = theme;
    document.querySelector('meta[name="theme-color"]').content = colors[theme];
    document.querySelector('link[rel="icon"]').href = '/favicon-' + theme + '.svg';
  };
  apply();
  document.addEventListener('visibilitychange', apply);
  window.addEventListener('pageshow', apply);
  setInterval(apply, 60000);
})();`;
interface Props {
  title: string;
  description?: string;
  dataVersion?: string;
}
const {
  title,
  description = "横浜の暮らしを、身近な問いから。政策の選択肢と財源、18区の人口と世帯の変化を、公式資料とともに確かめる。",
} = Astro.props;
const path = Astro.url.pathname;
const hold = heldPage(path);
const historyGeo = geographies.find((g) => path.includes(`/${g.slug}/`));
const historyLink =
  historyGeo && historyGeo.slug !== "yokohama"
    ? `/population-history/${historyGeo.slug}/`
    : "/population-history/";
const showHistory =
  path === "/" ||
  /^\/(wards|population-movement|age-structure)(\/|$)/.test(path);
const displayTitle = hold ? "この説明は確認中です" : title;
const displayDescription = hold
  ? "根拠を再確認しています。問い合わせと訂正をご覧ください。"
  : description;
const reportVersion = `${Astro.props.dataVersion ?? `人口データ SHA-256:${populationVersion}; データ公開版:${releaseId}`}`;
---

<!doctype html>
<html lang="ja" data-theme={themeConfig.defaultTheme}>
  <head>
    <meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <title>{displayTitle} | Open Yokohama</title><meta
      name="description"
      content={displayDescription}
    />
    <meta name="theme-color" content={themeColors[themeConfig.defaultTheme]} />
    <meta
      property="og:title"
      content={`${displayTitle} | Open Yokohama`}
    /><meta property="og:description" content={displayDescription} /><meta
      property="og:type"
      content="website"
    />
    <link
      rel="icon"
      href={`/favicon-${themeConfig.defaultTheme}.svg`}
      type="image/svg+xml"
    />
    <script is:inline set:html={themeScript} />
    {
      Astro.site && !Astro.site.hostname.endsWith(".example") && (
        <link rel="canonical" href={new URL(path, Astro.site)} />
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">本文へ移動</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="Open Yokohama ホーム"
          ><svg width="34" height="34" viewBox="0 0 40 40" aria-hidden="true"
            ><path
              d="M5 29h30M9 24h22M20 5v19M20 7L8 24h12M23 12l8 12"
              fill="none"
              stroke="currentColor"
              stroke-width="2"></path></svg
          ><span>Open Yokohama<small>横浜を知る、暮らしが見える。</small></span
          ></a
        >
        <nav aria-label="メインメニュー">
          {
            [
              ["/", "ホーム"],
              ["/issues/", "暮らしの問い"],
              ["/wards/", "18区を比べる"],
              ["/sources/", "データと出典"],
            ].map(([href, label]) => (
              <a
                href={href}
                aria-current={
                  path === href || (href !== "/" && path.startsWith(href))
                    ? "page"
                    : undefined
                }
              >
                {label}
              </a>
            ))
          }
        </nav>
        <a class="search-link" href="/search/" aria-label="サイト内を検索"
          >検索 <span aria-hidden="true">↗</span></a
        >
      </div>
    </header>
    <main id="main">
      {
        showHistory && !hold && (
          <aside class="container history-link">
            <>
              <a href={historyLink}>人口と暮らしを、約30年の変化で見る →</a>
              <p>
                人口・世帯は1995年以降、世代・出生・死亡・移動は2000年以降を読み合わせる。
              </p>
            </>
          </aside>
        )
      }
      {
        hold ? (
          <article class="container narrow section prose">
            <>
              <h1>この説明は確認中です</h1>
              <p>{hold.reason}</p>
              <p>
                <a href={`/corrections/#${hold.id}`}>確認状況を見る</a>
              </p>
            </>
          </article>
        ) : (
          <slot />
        )
      }
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <strong>Open Yokohama</strong><p>
            同じまちを、同じ根拠から考える。
          </p><small
            >市民による非公式のオープンソースプロジェクト。<br
            />横浜市の公式サイトではありません。</small
          >
          <a
            class="footer-github"
            href="https://github.com/toyofukux/open-yokohama"
            aria-label="GitHub（コードと記事づくりへの参加）"
            title="GitHub"
            ><svg viewBox="0 0 16 16" width="24" height="24" aria-hidden="true"
              ><path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
              ></path></svg
            ></a
          >
        </div><div>
          <a href="/datasets/">データ一覧・長期系列</a><a href="/about/"
            >このサイトについて</a
          ><a href="/sources/">データの見方・更新状況</a><a
            data-report-link
            href={reportUrl(path, reportVersion)}>このページについて知らせる</a
          ><a href="/corrections/">問い合わせと訂正</a><a href="/developers/"
            >開発者向け・MCP</a
          >
        </div>
      </div>
    </footer>
    <script>
      document.addEventListener("click", (event) => {
        const link = (event.target as Element).closest<HTMLAnchorElement>(
          "a[data-report-link]",
        );
        if (!link) return;
        const url = new URL(link.href);
        url.searchParams.set("page", location.pathname + location.search);
        link.href = url.href;
      });
    </script></body
  >
</html>

<style>
  .history-link {
    padding-top: 1.25rem;
    padding-bottom: 1.25rem;
    font-size: 0.9rem;
    border-bottom: 1px solid currentColor;
  }
  .history-link p {
    margin: 0.25rem 0 0;
  }
  .history-link a {
    font-weight: 700;
  }
</style>
