---
import "../styles/global.css";
import "../styles/themes.css";
import {
  resolveTheme,
  yokohamaSunTimes,
  themeConfig,
  themeColors,
  themeIds,
} from "../../../../packages/core/theme";
const themeScript = `(() => {
  const yokohamaSunTimes = ${yokohamaSunTimes.toString()};
  const select = ${resolveTheme.toString()};
  const config = ${JSON.stringify(themeConfig)};
  const colors = ${JSON.stringify(themeColors)};
  const ids = ${JSON.stringify(themeIds)};
  const preview = new URLSearchParams(location.search).get('theme');
  const apply = () => {
    const theme = ids.includes(preview) ? preview : select(config, Date.now());
    document.documentElement.dataset.theme = theme;
    document.querySelector('meta[name="theme-color"]').content = colors[theme];
    document.querySelector('link[rel="icon"]').href = '/favicon-' + theme + '.svg';
  };
  apply();
  document.addEventListener('visibilitychange', apply);
  window.addEventListener('pageshow', apply);
  setInterval(apply, 60000);
})();`;
interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "横浜の暮らしを、身近な問いから。政策の選択肢と財源、18区の人口と世帯の変化を、公式資料とともに確かめる。",
} = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="ja" data-theme={themeConfig.defaultTheme}>
  <head>
    <meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <title>{title} | Open Yokohama</title><meta
      name="description"
      content={description}
    />
    <meta name="theme-color" content={themeColors[themeConfig.defaultTheme]} />
    <meta property="og:title" content={`${title} | Open Yokohama`} /><meta
      property="og:description"
      content={description}
    /><meta property="og:type" content="website" />
    <link
      rel="icon"
      href={`/favicon-${themeConfig.defaultTheme}.svg`}
      type="image/svg+xml"
    />
    <script is:inline set:html={themeScript} />
    {
      Astro.site && !Astro.site.hostname.endsWith(".example") && (
        <link rel="canonical" href={new URL(path, Astro.site)} />
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">本文へ移動</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="Open Yokohama ホーム"
          ><svg width="34" height="34" viewBox="0 0 40 40" aria-hidden="true"
            ><path
              d="M5 29h30M9 24h22M20 5v19M20 7L8 24h12M23 12l8 12"
              fill="none"
              stroke="currentColor"
              stroke-width="2"></path></svg
          ><span>Open Yokohama<small>横浜を知る、暮らしが見える。</small></span
          ></a
        >
        <nav aria-label="メインメニュー">
          {
            [
              ["/", "ホーム"],
              ["/issues/", "暮らしの問い"],
              ["/wards/", "18区を比べる"],
              ["/sources/", "データと出典"],
            ].map(([href, label]) => (
              <a
                href={href}
                aria-current={
                  path === href || (href !== "/" && path.startsWith(href))
                    ? "page"
                    : undefined
                }
              >
                {label}
              </a>
            ))
          }
        </nav>
        <a class="search-link" href="/search/" aria-label="サイト内を検索"
          >検索 <span aria-hidden="true">↗</span></a
        >
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <strong>Open Yokohama</strong><p>
            同じまちを、同じ根拠から考える。
          </p><small
            >市民による非公式のオープンソースプロジェクト。<br
            />横浜市の公式サイトではありません。</small
          >
        </div><div>
          <a href="/about/">このサイトについて</a><a href="/sources/"
            >データの見方・更新状況</a
          ><a href="/about/#corrections">誤りを知らせる</a><a
            href="/developers/">開発者向け・MCP</a
          ><a href="https://github.com/toyofukux/open-yokohama">GitHub ↗</a>
        </div>
      </div>
    </footer>
  </body>
</html>
