{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "open-yokohama-mcp",
  "main": "src/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "compatibility_date": "2026-09-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.05
  },
  "limits": {
    "cpu_ms": 10
  },
  "build": {
    "command": "pnpm data:validate && pnpm factcheck:check",
    "watch_dir": [
      "../../data/editorial",
      "../../data/published",
      "../../packages"
    ]
  }
}
