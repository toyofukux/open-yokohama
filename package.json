{
  "name": "open-yokohama",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "astro dev --root apps/web --host 127.0.0.1",
    "build": "pnpm maps:check && pnpm childcare:charts:check && pnpm policy:charts:check && tsx scripts/validate-editorial.ts && tsx scripts/validate.ts && tsx scripts/validate-dynamics.ts && tsx scripts/validate-ages.ts && pnpm factcheck:check && astro build --root apps/web && tsx scripts/check-links.ts && tsx scripts/check-release-contract.ts",
    "check": "astro check --root apps/web && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "data:refresh": "tsx scripts/ingest.ts",
    "data:validate": "tsx scripts/validate.ts && tsx scripts/validate-dynamics.ts && tsx scripts/validate-ages.ts",
    "lint": "biome check packages scripts tests apps/mcp/src",
    "format": "biome check --write packages scripts tests apps/mcp/src",
    "preview": "wrangler dev --config wrangler.jsonc --port 8788",
    "deploy": "pnpm build && wrangler deploy --config wrangler.jsonc",
    "mcp:dev": "wrangler dev --config apps/mcp/wrangler.jsonc --local --ip 127.0.0.1 --port 8789 --var INTERNAL_MCP_ENABLED:true",
    "verify": "pnpm lint && pnpm lint:web && pnpm check && pnpm test && pnpm build",
    "test:mcp": "tsx scripts/mcp-smoke.ts",
    "format:web": "prettier --plugin prettier-plugin-astro --write 'apps/web/src/**/*.{astro,css,ts}'",
    "lint:web": "prettier --plugin prettier-plugin-astro --check 'apps/web/src/**/*.{astro,css,ts}'",
    "factcheck:prepare": "tsx scripts/factcheck-cache.ts && tsx scripts/factcheck.ts prepare",
    "factcheck:review": "tsx scripts/factcheck-cache.ts && tsx scripts/factcheck.ts review",
    "factcheck:check": "tsx scripts/factcheck-archive.ts && tsx scripts/validate-editorial.ts",
    "test:factcheck-gates": "tsx scripts/factcheck-gate-smoke.ts",
    "factcheck:eval": "tsx scripts/factcheck-eval.ts",
    "factcheck:sources": "tsx scripts/factcheck-sources.ts",
    "test:corrections": "tsx scripts/corrections-smoke.ts",
    "data:refresh:dynamics": "tsx scripts/ingest-dynamics.ts",
    "test:dynamics-gates": "tsx scripts/dynamics-gate-smoke.ts",
    "data:refresh:ages": "tsx scripts/ingest-ages.ts",
    "test:ages-gates": "tsx scripts/ages-gate-smoke.ts",
    "dwh:check": "tsx scripts/warehouse.ts check",
    "dwh:publish": "tsx scripts/warehouse.ts publish",
    "dwh:query": "tsx scripts/warehouse.ts query",
    "dwh:article": "tsx scripts/warehouse.ts article",
    "dwh:restore": "tsx scripts/warehouse.ts restore",
    "data:refresh:history": "tsx scripts/ingest-history.ts",
    "data:refresh:all": "tsx scripts/refresh-all.ts",
    "maps:build": "tsx scripts/build-ward-evidence.ts",
    "maps:check": "tsx scripts/build-ward-evidence.ts --check",
    "factcheck:archive-originals": "tsx scripts/factcheck-archive.ts --originals",
    "test:factcheck-archive-originals": "tsx scripts/factcheck-gate-smoke.ts --originals",
    "childcare:charts:build": "tsx scripts/build-childcare-charts.ts",
    "childcare:charts:check": "tsx scripts/build-childcare-charts.ts --check",
    "policy:charts:build": "tsx scripts/build-policy-breakdowns.ts",
    "policy:charts:check": "tsx scripts/build-policy-breakdowns.ts --check"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.12",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "astro": "7.3.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "wrangler": "4.129.0",
    "@astrojs/markdown-remark": "^7.3.0",
    "@resvg/resvg-js": "2.6.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "csv-parse": "^7.0.2",
    "parse5": "^8.0.1",
    "zod": "4.5.4"
  }
}
