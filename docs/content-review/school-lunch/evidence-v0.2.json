      "review": "author_self_check"
    },
    {
      "id": "R13",
      "type": "uncertainty_and_editorial",
      "claim": "追加費用未確定、他の支援・開始時期・継続条件との比較",
      "evidence": [
        {
          "sourceId": "S1",
          "locator": "臨時交付金の利用"
        },
        {
          "sourceId": "S11",
          "locator": "中学校についての検討"
        }
      ],
      "limits": "実施可能性も特定事業の削減も未確定。仮の比較方法であり金額推計や推奨ではない",
      "review": "author_self_check"
    },
    {
      "id": "R14",
      "type": "editorial_synthesis",
      "claim": "目的・対象・費用継続条件を分け、別の支援にも問う",
      "evidence": [],
