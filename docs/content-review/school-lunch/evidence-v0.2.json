  "claims": [
    {
      "id": "R01",
      "type": "fact",
      "claim": "横浜市立中学校の就学援助認定者は給食費支払い不要",
      "evidence": [
        {
          "sourceId": "S3",
          "locator": "PDF4ページ8-2"
        }
      ],
      "limits": "制度の対象認定と困窮世帯全体を同一視しない",
      "review": "author_self_check"
    },
    {
      "id": "R02",
      "type": "fact_and_editorial",
      "claim": "国の小学校段階支援は子育て支援が目的。困難への援助と広い公的分担を分ける",
      "evidence": [
        {
          "sourceId": "S2",
          "locator": "どんな取組・いつから"
        },
        {
          "sourceId": "S10",
          "locator": "PDF3ページ趣旨・対象"
        }
      ],
      "limits": "目的の違いは確認できる。二つの問いへの分解は編集上の整理であり全論点の網羅ではない",
      "review": "author_self_check"
    },
    {
      "id": "R03",
      "type": "historical_document",
      "claim": "給食費用の分担と1970年答申の理由",
      "evidence": [
        {
          "sourceId": "S9",
          "locator": "PDF4ページ経費負担・昭和45年答申"
        }
      ],
      "limits": "歴史的な公的整理。現在も唯一妥当な分担とする規範判断ではない",
      "review": "author_self_check"
    },
    {
      "id": "R04",
      "type": "fact",
      "claim": "中学校通常フルセット330円、物価高補助、援助認定者は支払い不要",
      "evidence": [
        {
          "sourceId": "S1",
          "locator": "1.(2)"
        },
        {
          "sourceId": "S3",
          "locator": "PDF4ページ8-2"
        }
      ],
      "limits": "私立・特別支援学校中学部を同一料金としない",
      "review": "author_self_check"
    },
    {
      "id": "R05",
      "type": "conditional_calculation",
      "claim": "330円×仮定の20食＝6600円。既存の支払い不要者には同額の追加現金ではない",
      "evidence": [
        {
          "sourceId": "S1",
          "locator": "1.(2)"
        },
        {
          "sourceId": "S3",
          "locator": "PDF4ページ8-2"
        }
      ],
      "limits": "20食は編集上の例。月平均・年額・追加予算ではない",
      "review": "author_self_check"
    },
    {
      "id": "R06",
      "type": "fact_and_hypothesis",
      "claim": "援助の対象条件、申請と審査中の扱い、未確認の到達実態",
      "evidence": [
        {
          "sourceId": "S3",
          "locator": "PDF1・2ページ条件、4ページ8-1・8-2"
        }
      ],
      "limits": "非申請者や立替困難の人数・原因は未確認。発生率を推測しない",
      "review": "author_self_check"
    },
    {
      "id": "R07",
      "type": "document_and_editorial",
      "claim": "2026年度は所得を問わない子育て支援。目的ごとに公平さと評価を分ける",
      "evidence": [
        {
          "sourceId": "S10",
          "locator": "PDF3ページ趣旨・対象"
        }
      ],
      "limits": "公的制度の目的と当サイトによる価値軸の整理を区別。政策効果は実証していない",
      "review": "author_self_check"
    },
    {
      "id": "R08",
      "type": "fact_and_editorial",
      "claim": "横浜小学校段階0円、市上乗せと臨時交付金。目的に照らした対象境界の問い",
      "evidence": [
        {
          "sourceId": "S1",
          "locator": "1.(1)(2)"
        },
        {
          "sourceId": "S2",
          "locator": "どんな取組"
        }
      ],
      "limits": "料金差を不公平の証拠にしない。すべての小学校や自治体が0円とはしない",
      "review": "author_self_check"
    },
    {
      "id": "R09",
      "type": "attributed_statement",
      "claim": "2026年7月21日大臣会見では実施状況の違い等を整理して中学校支援を検討",
      "evidence": [
        {
          "sourceId": "S11",
          "locator": "最後の質疑の大臣回答"
        }
      ],
      "limits": "当該発言には開始日・金額確定なし。9月までの全決定を網羅した主張ではない。記者質問を知事会原本の代用にしない",
      "review": "author_self_check"
    },
    {
      "id": "R10",
      "type": "editorial_scenarios",
      "claim": "現行維持・援助変更・一律0円の対象と残る条件の比較",
      "evidence": [
        {
          "sourceId": "S1",
          "locator": "現行料金"
        },
        {
          "sourceId": "S3",
          "locator": "現行援助"
        }
      ],
      "limits": "市の決定や候補者公約ではない。併用可能性を残し採用を勧めない",
      "review": "author_self_check"
    },
    {
      "id": "R11",
      "type": "editorial_scenarios",
      "claim": "所得条件以外の対象境界、現金等の別手段、別援助の手続き",
      "evidence": [
        {
          "sourceId": "S3",
          "locator": "PDF1ページ援助費目と申請"
        },
        {
          "sourceId": "S9",
          "locator": "PDF5ページ喫食しない人への支援範囲の論点"
        }
      ],
      "limits": "中学校拡張時の検討例。私立等への現行制度を一括で無支援と断定しない",
      "review": "author_self_check"
    },
    {
      "id": "R12",
      "type": "fact_and_editorial",
      "claim": "財源・正味追加費用の区別。当初事業に改修中の小学校向け供給が含まれる",
      "evidence": [
        {
          "sourceId": "S4",
          "locator": "PDF3ページ細事業欄2"
        }
      ],
