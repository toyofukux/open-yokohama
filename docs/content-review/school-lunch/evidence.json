  "claims": [
    {
      "id": "F01",
      "type": "fact",
      "text": "市立小学校段階の保護者負担0円、中学校・義務教育学校後期は通常フルセット330円／食",
      "evidence": [
        {
          "sourceId": "S1",
          "locator": "1(1)(2)、最終更新2026-06-15"
        }
      ],
      "limits": "2026年度。特別支援学校小学部以外・私立等へ外挿しない",
      "reviewStatus": "author_checked_not_independent"
    },
    {
      "id": "F02",
      "type": "fact",
      "text": "中学校の就学援助認定者は給食費支払い不要",
      "evidence": [
        {
          "sourceId": "S3",
          "locator": "PDF4ページ、8-2"
        }
      ],
      "limits": "制度の説明。受給者数や効果の実測ではない",
      "reviewStatus": "author_checked_not_independent"
    },
    {
      "id": "F03",
      "type": "fact",
      "text": "国の新制度は公立小学校段階、通常完全給食5,200円／月、11か月。自治体への食材費支援",
      "evidence": [
        {
          "sourceId": "S2",
          "locator": "事業の概要"
        }
      ],
      "limits": "2026年4月開始。他の既存援助制度を否定しない",
      "reviewStatus": "author_checked_not_independent"
    },
    {
      "id": "F04",
      "type": "fact",
      "text": "小学校の食材費6,141円／月、国基準5,200円、市補填941円。中学校は市が110円／日を支援",
      "evidence": [
        {
          "sourceId": "S7",
          "locator": "PDF31ページ、冊子23ページ、コラム2"
        }
      ],
      "limits": "2026-05-18説明。食材費であり給食事業総費用ではない",
      "reviewStatus": "author_checked_not_independent"
    },
    {
      "id": "F05",
      "type": "fact",
      "text": "市の上乗せ支援に2026年度は国の物価高対策の臨時交付金を活用",
      "evidence": [
        {
          "sourceId": "S7",
          "locator": "PDF31ページ最下部注記"
        },
        {
          "sourceId": "S1",
          "locator": "1(1)(2)の補助説明"
        }
      ],
      "limits": "将来の財源を保証しない",
      "reviewStatus": "author_checked_not_independent"
    },
    {
      "id": "F06",
      "type": "fact",
      "text": "初回申請等は審査中支払い後に認定で返金、前年末対象者は結果待ちも支払い不要",
      "evidence": [
        {
          "sourceId": "S3",
          "locator": "PDF4ページ、8-1"
        }
      ],
      "limits": "2026年度。非申請者の規模や動機を推定しない",
      "reviewStatus": "author_checked_not_independent"
    },
    {
      "id": "F07",
      "type": "fact",
      "text": "指定都市の国への提案事項案に中学校を含む制度化と安定財源を記載",
      "evidence": [
        {
          "sourceId": "S5",
          "locator": "PDF1・4・16ページ、6月8日委員会資料"
        }
      ],
      "limits": "案。国の決定・要請済み・市の確定公約とはしない",
      "reviewStatus": "author_checked_not_independent"
    },
    {
      "id": "F08",
      "type": "fact",
      "text": "中学校給食物資購入事業には給食室改修中の小学校への供給分を含む",
      "evidence": [
        {
          "sourceId": "S4",
          "locator": "PDF3ページ、冊子2ページ、最下段細事業"
        }
      ],
      "limits": "2026年度当初計画。決算額・無償化追加額ではない",
      "reviewStatus": "author_checked_not_independent"
    },
    {
      "id": "D01",
      "type": "calculation",
      "text": "330円×20食＝6,600円",
      "evidence": [
        {
          "sourceId": "S1",
          "locator": "1(2)の通常フルセット単価"
        }
      ],
      "limits": "20食は編集上の仮定。毎月の請求額・年間負担ではない",
      "reviewStatus": "author_checked_not_independent"
    },
    {
      "id": "I01",
      "type": "editorial_analysis",
      "text": "判断の中心を支援対象・負担の重さ・継続財源に置く",
      "dependsOn": [
